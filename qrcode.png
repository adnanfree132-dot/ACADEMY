      // Fills the collapsed category accordions on first expand. Shares the same
      // cached /search-index.json the header search fetches, so if the visitor has
      // already opened search it is served from cache with no extra request.
      (function () {
        var cache = null;
        var pending = null;
        function loadIndex() {
          if (cache) return Promise.resolve(cache);
          if (!pending) {
            pending = fetch('/search-index.json')
              .then(function (r) {
                if (!r.ok) throw new Error('search index ' + r.status);
                return r.json();
              })
              .then(function (data) { cache = data; return data; });
          }
          return pending;
        }

        document.querySelectorAll('details[data-lazy-cat]').forEach(function (details) {
          details.addEventListener('toggle', function () {
            if (!details.open || details.dataset.loaded) return;
            details.dataset.loaded = '1';
            var body = details.querySelector('[data-lazy-body]');
            if (!body) return;

            loadIndex().then(function (allTools) {
              var items = allTools.filter(function (t) { return t.c === details.dataset.lazyCat; });
              if (!items.length) return; // keep the category-link fallback
              var frag = document.createDocumentFragment();
              items.forEach(function (t) {
                var a = document.createElement('a');
                a.href = '/tools/' + t.s + '/';
                a.className = 'flex items-center gap-2 rounded-lg bg-slate-50 px-3 py-2 text-sm text-slate-700 transition hover:bg-slate-100 hover:text-indigo-700';
                a.textContent = t.e + ' ' + t.t;
                frag.appendChild(a);
              });
              body.replaceChildren(frag);
            }).catch(function () {
              // Network/parse failure: allow a retry on the next open and leave
              // the server-rendered category link in place so nothing is lost.
              details.dataset.loaded = '';
              pending = null;
            });
          });
        });
      })();
